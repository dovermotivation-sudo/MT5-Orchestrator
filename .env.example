# Bhionex API Configuration
API_BASE_URL=https://api.bhionex.com
BOT_API_KEY=your_bot_api_key_here

# MT5 Cloner Configuration
# Path to your master MT5 folder that acts as the template
MASTER_MT5_DIR=C:/path/to/master/MT5

# Directory where all cloned user accounts will be created
CLIENTS_DIR=C:/path/to/MT5_clients

# Orchestrator Configuration
# The sync/polling interval in seconds (default: 60)
ORCHESTRATOR_INTERVAL=60

